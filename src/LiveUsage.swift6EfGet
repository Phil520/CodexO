import Foundation

/// 从 Codex 官方接口取实时额度。
///
/// ## 为什么需要这一层（2026-11-12）
///
/// 原来的唯一数据源是 `~/.codex/sessions/*.jsonl` 里的 `rate_limits` 字段。
/// 但那个字段**只在 Codex 真正发起请求时才落盘**，而且新版 Codex 写得越来越稀。
/// 实测：11-12 上午 10:58 之后就没有任何新记录，到下午 14:30 已经停更 3 个半小时。
///
/// 停更之后，旧读数里的 `resets_at` 又都过了期，`UsageReader` 就按「窗口已重置」
/// 判成剩余 100% —— 而真实值是 92%。**把「不知道」当成「满额」，比显示旧值更误导。**
///
/// 官方接口 `backend-api/wham/usage` 直接返回当前窗口：
///
///     { "rate_limit": {
///         "primary_window":   { "used_percent": 8, "limit_window_seconds": 18000, ... },
///         "secondary_window": { "used_percent": 1, "limit_window_seconds": 604800, ... } } }
///
///     primary   = 5 小时窗口（18000 秒）
///     secondary = 每周窗口（604800 秒）
///
/// ## 设计上的三条约束
///
/// 1. **绝不在主线程上等网络**。菜单每分钟刷新一次，网络一卡就会拖住整个界面。
///    这里改成「后台请求 → 结果进缓存 → 主线程取缓存」，取不到就用本地文件兜底。
/// 2. **凭证只读不写**。只从 `~/.codex/auth.json` 读现成的 access_token，
///    不刷新、不落盘、不转发到任何其它地址。
/// 3. **失败要静默降级**。接口不通、token 过期、结构变化，都只是回退到本地文件，
///    不在界面上制造报错噪音 —— 用户关心的是数，不是哪条链路挂了。
enum LiveUsage {

    /// Codex 使用的额度查询端点。
    /// 同一份数据在 `backend-api/codex/usage` 下也能拿到，这里取 wham 这个更短的稳定路径。
    private static let endpoint = URL(string: "https://chatgpt.com/backend-api/wham/usage")!

    /// 缓存有效期。接口 60 秒内不重复请求：
    /// 额度是 5 小时粒度的东西，没必要每分钟打一次，也不该给账号添无谓的调用记录。
    private static let freshFor: TimeInterval = 60

    /// 拿到的读数最多可信多久。超过这个时间就不再用它，
    /// 让 `UsageReader` 回退到本地文件 —— 宁可显示旧的本地值，也不显示过时的「实时值」。
    private static let usableFor: TimeInterval = 300

    private static let queue = DispatchQueue(label: "com.bean.codexo.liveusage")
    private static var cached: UsageSnapshot?
    private static var cachedAt: Date?
    private static var inFlight = false
    /// 连续失败次数。用于退避：一直失败就别每分钟都去试。
    private static var consecutiveFailures = 0

    /// 主线程用：取最近一次成功拿到的快照，取不到就返回 nil（调用方回退本地文件）。
    /// 完全不阻塞。
    static func cachedSnapshot(now: Date = Date()) -> UsageSnapshot? {
        guard let snapshot = cached, let at = cachedAt else { return nil }
        guard now.timeIntervalSince(at) <= usableFor else { return nil }
        // 快照里的时间要跟着走，否则界面上会显示「3 分钟前」这种越来越旧的时间
        return UsageSnapshot(fiveHour: snapshot.fiveHour,
                             weekly: snapshot.weekly,
                             sourceFile: snapshot.sourceFile,
                             recordTime: snapshot.recordTime,
                             loadedAt: now,
                             error: nil,
                             isLive: true)
    }

    /// 后台刷新。多次调用会合并，不会堆起一堆并发请求。
    /// - Parameter completion: 成功拿到新数据时在主线程回调（用于重画菜单栏）。
    static func refreshInBackground(force: Bool = false, completion: (() -> Void)? = nil) {
        queue.async {
            let now = Date()
            if inFlight { return }
            if !force, let at = cachedAt, now.timeIntervalSince(at) < freshFor { return }

            // 退避：连续失败后把重试间隔拉长，避免网络长期不通时每分钟白试一次。
            if !force, consecutiveFailures > 0 {
                let backoff = min(Double(consecutiveFailures) * freshFor, 600)
                if let at = cachedAt ?? lastAttemptAt, now.timeIntervalSince(at) < backoff { return }
            }

            inFlight = true
            lastAttemptAt = now
            let snapshot = requestSnapshot()
            inFlight = false

            if let snapshot {
                consecutiveFailures = 0
                cached = snapshot
                cachedAt = Date()
                if let completion {
                    DispatchQueue.main.async(execute: completion)
                }
            } else {
                consecutiveFailures += 1
            }
        }
    }

    private static var lastAttemptAt: Date?

    /// 读 auth.json 里的凭证。读不到就返回 nil —— 没登录 Codex 的人本来也走不到实时接口。
    private static func credentials() -> (token: String, account: String)? {
        let path = NSHomeDirectory() + "/.codex/auth.json"
        guard let data = try? Data(contentsOf: URL(fileURLWithPath: path)),
              let root = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
              let tokens = root["tokens"] as? [String: Any],
              let token = tokens["access_token"] as? String, !token.isEmpty,
              let account = tokens["account_id"] as? String, !account.isEmpty else {
            return nil
        }
        return (token, account)
    }

    /// 真正发请求。同步执行 —— 但只在后台队列上被调用。
    private static func requestSnapshot() -> UsageSnapshot? {
        guard let creds = credentials() else { return nil }

        var request = URLRequest(url: endpoint)
        request.httpMethod = "GET"
        // 超时压到 8 秒：后台失败无所谓，但不能让一次请求挂太久占着队列
        request.timeoutInterval = 8
        request.setValue("Bearer \(creds.token)", forHTTPHeaderField: "Authorization")
        request.setValue(creds.account, forHTTPHeaderField: "chatgpt-account-id")
        request.setValue("application/json", forHTTPHeaderField: "Accept")
        // Codex 后端会按 UA 区分客户端，带一个明确的自报身份比伪装更规矩
        request.setValue("CodexO/1.0.5", forHTTPHeaderField: "User-Agent")

        let semaphore = DispatchSemaphore(value: 0)
        var payload: Data?
        var statusCode = -1

        let task = URLSession.shared.dataTask(with: request) { body, response, _ in
            payload = body
            statusCode = (response as? HTTPURLResponse)?.statusCode ?? -1
            semaphore.signal()
        }
        task.resume()

        // 比 timeoutInterval 略宽，保证 URLSession 自己先超时，这里只是兜底
        guard semaphore.wait(timeout: .now() + 12) == .success else {
            task.cancel()
            return nil
        }
        guard statusCode == 200, let payload else { return nil }

        return parse(payload)
    }

    /// 解析接口返回。结构变了就返回 nil，让调用方回退本地文件，不猜。
    private static func parse(_ data: Data) -> UsageSnapshot? {
        guard let root = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
              let rateLimit = root["rate_limit"] as? [String: Any] else { return nil }

        let now = Date()

        func window(_ key: String) -> UsageWindow? {
            guard let dict = rateLimit[key] as? [String: Any],
                  let used = (dict["used_percent"] as? NSNumber)?.doubleValue else { return nil }
            let seconds = (dict["limit_window_seconds"] as? NSNumber)?.doubleValue
            let resetAt = (dict["reset_at"] as? NSNumber).map { Date(timeIntervalSince1970: $0.doubleValue) }
            return UsageWindow(remaining: min(100, max(0, 100 - used)),
                               used: used,
                               resetAt: resetAt,
                               windowMinutes: Int((seconds ?? 0) / 60),
                               expired: false)
        }

        let primary = window("primary_window")
        let weekly = window("secondary_window")
        guard primary != nil || weekly != nil else { return nil }

        return UsageSnapshot(fiveHour: primary,
                             weekly: weekly,
                             sourceFile: "Codex 实时接口",
                             recordTime: now,
                             loadedAt: now,
                             error: nil,
                             isLive: true)
    }
}
